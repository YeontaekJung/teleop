<?xml version="1.0"?>
<package format="3">
  <name>vive_rby1</name>
  <version>0.1.0</version>
  <description>
    Vive tracker to RB-Y1 teleoperation bridge.
    Subscribes to tracker poses and pedal events, computes teleop targets,
    and publishes RB-Y1 teleoperation commands.
  </description>
  <maintainer email="todo@todo.com">todo</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>rby1_core_msgs</depend>
  <depend>scm_recording_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>eigen</depend>

  <!-- rby1-sdk (dynamics model for FK) is found via find_package, not ament;
       no package.xml dependency, mirroring hw-core/rby1_core. -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
